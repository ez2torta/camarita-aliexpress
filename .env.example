# Copia este archivo a `.env` y rellena los valores. `.env` esta en .gitignore.

# --- Obligatorio ---------------------------------------------------------
# Device ID que muestra la app CY365 (pantalla de ajustes de la camara).
# NO se puede descubrir solo: la camara ignora el handshake si el DID no es el
# suyo (probado: con un DID falso no hay sesion). Tratalo como semi-secreto.
CY365_DID=EEE-123456-ABCDE

# --- Contrasena de la camara --------------------------------------------
# 6666 es la de fabrica en esta familia.
CY365_PASSWORD=6666

# --- Opcionales ----------------------------------------------------------
# Usuario de la camara. En estas T99 es "admin".
CY365_USER=admin

# IP de la camara. Si la dejas vacia se descubre por broadcast (mas lento y
# depende de que la camara este despierta). Ponerla acelera el arranque.
CY365_CAM_IP=192.168.0.26

# Puerto del servidor MJPEG dentro del contenedor (y en el NAS, por host net).
CY365_HTTP_PORT=8091

# Proteccion con HTTP Basic: usuario:contrasena. VACIO = sin proteccion.
# Ponlo si el puerto va a quedar accesible fuera de tu LAN o de tu Tailscale.
# CY365_AUTH=casa:algo-largo-y-aleatorio

# Poner 1 para ver todo el trafico del protocolo en los logs.
# CY365_DEBUG=1
